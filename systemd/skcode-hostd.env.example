# skcode-hostd.env.example: tunables for skcode-hostd.service.
#
# Copy to ~/.config/skcode-hostd/skcode-hostd.env and fill in the values for
# this node. systemd loads it via EnvironmentFile; the .service references
# ${SKCODE_HOSTD_TAILSCALE_IP} and ${SKCODE_HOSTD_HOST_ID} in its ExecStart.

# REQUIRED. The Tailscale (tailnet) IP to bind, e.g. 100.64.0.2.
# serve.py's resolve_bind() REFUSES a wildcard/public address (0.0.0.0, ::, or
# blank), so this MUST be a real tailnet IP. Never set a public/wildcard value.
SKCODE_HOSTD_TAILSCALE_IP=

# REQUIRED. This node's host id (used for hosts/self identity), e.g. .158.
SKCODE_HOSTD_HOST_ID=

# OPTIONAL and now REDUNDANT. Since CR-3.2 serve.py's select_verifier() runs the
# REAL capauth verifier by DEFAULT; it falls back to the deny-all placeholder
# only when capauth cannot be imported, or when SKCODE_FORCE_DENY_ALL is truthy.
# Setting this key forces the real verifier explicitly and changes nothing else.
# There is no configuration in which a missing or invalid token is accepted.
# SKCODE_REAL_VERIFIER=1

# OPTIONAL escape hatch. Truthy forces the deny-all verifier: EVERY caller is
# denied and nothing actuates. This is the way to disarm the surface without
# stopping the unit. It still fails closed.
# SKCODE_FORCE_DENY_ALL=1

# OPTIONAL, and DELIBERATELY ABSENT BY DEFAULT. Comma-separated ABSOLUTE repo
# roots that POST /api/v1/dispatch may spawn a session into. Dispatch is remote
# code execution, and this allowlist is the last gate in front of it.
#
#   UNSET or EMPTY  ==  DENY ALL  (harnesses/claude_code.py spawn guard)
#
# Leave it unset unless this node is meant to dispatch. When you do set it, list
# only repos an agent may safely rewrite:
#
#   SKCODE_DISPATCH_REPOS=/home/<user>/path/to/repo-a,/home/<user>/path/to/repo-b
#
# NEVER list skos or skharness. They are the self-modification hazard: skharness
# is the code enforcing the twin gate, the carve-out detector and this very
# allowlist, and skos is the autopilot that drives it. An agent dispatched into
# either could edit its own leash, and the change would then be graded by the
# code it just edited. This rule is enforced by the operator, not by code.
# SKCODE_DISPATCH_REPOS=
