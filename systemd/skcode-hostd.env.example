# skcode-hostd.env.example: tunables for skcode-hostd.service.
#
# Copy to ~/.config/skcode-hostd/skcode-hostd.env and fill in the values for
# this node. systemd loads it via EnvironmentFile; the .service references
# ${SKCODE_HOSTD_TAILSCALE_IP} and ${SKCODE_HOSTD_HOST_ID} in its ExecStart.

# REQUIRED. The Tailscale (tailnet) IP to bind, e.g. 100.64.0.2.
# serve.py's resolve_bind() REFUSES a wildcard/public address (0.0.0.0, ::, or
# blank), so this MUST be a real tailnet IP. Never set a public/wildcard value.
SKCODE_HOSTD_TAILSCALE_IP=

# REQUIRED. This node's host id (used for hosts/self identity), e.g. .158.
SKCODE_HOSTD_HOST_ID=

# OPTIONAL, OFF BY DEFAULT. Leave this commented out to keep the safe P0
# posture: with SKCODE_REAL_VERIFIER unset, serve.py's select_verifier() runs
# the deny-all placeholder, so no caller is ever accepted and the RCE surface
# stays gated. Only enable the real capauth verifier AFTER the pairing/verifier
# is provisioned (spec 7.6); enabling it before then would swap deny-all for a
# verifier that has nothing to verify against.
# SKCODE_REAL_VERIFIER=1
